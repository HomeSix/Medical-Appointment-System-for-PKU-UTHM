{
  "name": "Medical Appointment System GUI",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "vscode",
      "webPort": "6080"
    }
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Virtual Desktop",
      "onAutoForward": "openBrowser"
    }
  },
  "runArgs": [
    "--init",
    "--shm-size=1g"
  ],
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y gcc make libgtk-3-dev"
}
